# Copy to .env for local development. Never commit .env.

APP_ENV=development
PORT=8080
# Interface to listen on. Behind a TLS proxy on the same host use 127.0.0.1.
HTTP_HOST=

# --- Postgres -------------------------------------------------------------
POSTGRES_DSN=postgres://cinefund:cinefund@localhost:5433/cinefund?sslmode=disable
POSTGRES_MAX_CONNS=10

# --- Redis ----------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_DB=0

# --- Kafka ----------------------------------------------------------------
KAFKA_BROKERS=localhost:9092

# --- Object storage (MinIO locally) --------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_ORIGINALS=cinefund-originals
S3_BUCKET_MEDIA=cinefund-media

# --- Auth -----------------------------------------------------------------
# Must be >= 32 bytes each and DIFFERENT from one another. Config validation
# refuses to boot otherwise.
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-32b
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-32

# POST /api/v1/auth/demo issues real tokens for the two fixed demo accounts
# (Ava the creator, Ravi the backer). Safe to enable on a public demo: it
# cannot mint a token for any other user. Off unless set.
DEMO_LOGIN_ENABLED=true

# Accept a bare X-User-ID header in place of a token, for poking the API with
# curl. Anyone can set a header, so config validation refuses this unless
# APP_ENV=development.
ALLOW_DEV_IDENTITY_HEADER=false

# --- Payments -------------------------------------------------------------
# Leave blank in development: the fake gateway is used when the key is empty.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=dev-webhook-secret

# --- Transcoding ----------------------------------------------------------
TRANSCODE_CONCURRENCY=2
TRANSCODE_TMP_DIR=./tmp/transcode
